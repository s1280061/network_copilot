# AI provider: "groq" | "openai" | "anthropic" | "mock"
# "mock" works with no API key (rule-based offline answers).
AI_PROVIDER=mock

# Used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Used when AI_PROVIDER=groq (OpenAI-compatible). https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS origin of the frontend
FRONTEND_ORIGIN=http://localhost:3000
